{
  "name": "social-media-pubulish-mcp",
  "version": "0.1.0",
  "description": "MCP server for drafting social media image posts with browser automation.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "install-browsers": "playwright install chromium",
    "guard:codex": "bash scripts/codex-resource-guard.sh --once",
    "guard:codex:watch": "bash scripts/codex-resource-guard.sh --watch",
    "guard:codex:status": "bash scripts/codex-resource-guard.sh --status",
    "guard:codex:install": "bash scripts/codex-resource-guard.sh --install-launch-agent",
    "guard:codex:uninstall": "bash scripts/codex-resource-guard.sh --uninstall-launch-agent",
    "smoke:mcp": "tsx scripts/mcp-smoke-client.ts",
    "smoke:xiaohongshu": "tsx scripts/smoke-xiaohongshu-draft.ts",
    "smoke:csdn": "tsx scripts/smoke-article-draft.ts csdn",
    "smoke:zhihu": "tsx scripts/smoke-article-draft.ts zhihu",
    "smoke:wechat": "tsx scripts/smoke-article-draft.ts wechat",
    "smoke:douyin": "tsx scripts/smoke-douyin-draft.ts start",
    "smoke:douyin:start": "tsx scripts/smoke-douyin-draft.ts start",
    "smoke:douyin:status": "tsx scripts/smoke-douyin-draft.ts status",
    "smoke:douyin:watch": "tsx scripts/smoke-douyin-draft.ts watch",
    "smoke:douyin:submit": "tsx scripts/smoke-douyin-draft.ts submit",
    "smoke:douyin:stop": "tsx scripts/smoke-douyin-draft.ts stop",
    "mcp:processes": "tsx scripts/mcp-processes.ts list",
    "mcp:processes:kill": "tsx scripts/mcp-processes.ts kill"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.49.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
